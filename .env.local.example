# Supabase is OPTIONAL. Without it, PodTrackr runs on a bundled demo dataset
# and persists your follows / added initiatives in the browser (localStorage).
# Set these to persist data to your own Supabase project (run supabase/schema.sql first).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
